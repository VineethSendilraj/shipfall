# Cloudflare Pages response headers. Copied to dist/_headers by the build.
# frame-ancestors lets X embed /embed/ in a player card; there is deliberately no X-Frame-Options.
/*
  Content-Security-Policy: frame-ancestors 'self' https://x.com https://*.x.com https://twitter.com https://*.twitter.com
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable
